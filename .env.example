# Helix OAuth login (optional). HELIX_ENABLED=false (default) means no
# login gate at all. true means every route requires Helix login plus
# HELIX_WORKSPACE_TENANT membership.
#
# A Helix workspace admin must register this app as a PUBLIC client (no
# secret issued or sent — PKCE only, this is a static SPA with no
# backend) at <HELIX_BASE_URL>/auth/oauth/apps/new/, with this app's
# callback URL: <this app's origin>/auth/helix/callback — register that
# exact URL per domain (a trailing wildcard, e.g. http://localhost:4200/*,
# works for local dev).
HELIX_ENABLED=false
HELIX_BASE_URL=https://helix.changeme.example
HELIX_OAUTH_CLIENT_ID=changeme
# Workspace slug the OAuth app is registered under (sent as tenant= at
# authorize time). May differ from HELIX_WORKSPACE_TENANT below.
HELIX_OAUTH_TENANT=changeme
# Workspace slug a logged-in user must belong to for this app to admit
# them (checked via GET /api/v1/tenants/ after login).
HELIX_WORKSPACE_TENANT=changeme
